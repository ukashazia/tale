#compdef tale

autoload -U is-at-least

_tale() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_tale_commands" \
"*::: :->tale" \
&& ret=0
    case $state in
    (tale)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tale-command-$line[1]:"
        case $line[1] in
            (gen-completions)
_arguments "${_arguments_options[@]}" : \
'--shell=[Shell to generate completions for\: bash, zsh, or fish]:SHELL:_default' \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(auth)
_arguments "${_arguments_options[@]}" : \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_tale__subcmd__auth_commands" \
"*::: :->auth" \
&& ret=0

    case $state in
    (auth)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tale-auth-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'--tailnet=[Tailnet ID or '\''-'\''; prompts when omitted]:ID:_default' \
'--kind=[Credential type\: oauth-client or access-token; prompts when omitted]:KIND:(oauth-client access-token)' \
'--client-id=[OAuth client ID; required with --secret-stdin for oauth-client credentials]:ID:_default' \
'--scopes=[Comma-separated OAuth scopes; prompts when omitted for oauth-client credentials]:SCOPES:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--secret-stdin[Read the secret from standard input instead of prompting. Selects the access token, or the client secret when the kind is \`oauth_client\`]' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
':profile -- Name for the profile. Use letters, digits, '\''_'\'' and '\''-'\'':_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
':profile -- Name of the profile:_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
'::profile -- Profile to inspect; defaults to --profile:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(config)
_arguments "${_arguments_options[@]}" : \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_tale__subcmd__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tale-config-command-$line[1]:"
        case $line[1] in
            (path)
_arguments "${_arguments_options[@]}" : \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--output=[Write the report to PATH instead of standard output]:PATH:_files' \
'--profile=[Select a configured tailnet profile for this session]:NAME:_default' \
'--config=[Read configuration from PATH instead of the default config location]:PATH:_files' \
'--view=[Open ROUTE when the terminal interface starts]:ROUTE:_default' \
'--tailscale-path=[Use PATH as the local Tailscale executable]:PATH:_files' \
'--tailscale-socket=[Connect to the local Tailscale daemon at PATH]:PATH:_files' \
'--read-only[Disable every mutation for this session]' \
'--no-local[Do not connect to the local Tailscale client or daemon]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_tale_commands] )) ||
_tale_commands() {
    local commands; commands=(
'gen-completions:Print shell completion instructions to standard output' \
'auth:Add, inspect, or remove tailnet credentials' \
'config:Inspect and validate Tale configuration' \
'doctor:Print a redacted, non-mutating diagnostic report' \
    )
    _describe -t commands 'tale commands' commands "$@"
}
(( $+functions[_tale__subcmd__auth_commands] )) ||
_tale__subcmd__auth_commands() {
    local commands; commands=(
'add:Create or update a credential profile' \
'remove:Delete a credential profile and its stored secret' \
'status:Show the selected profile'\''s credential status' \
    )
    _describe -t commands 'tale auth commands' commands "$@"
}
(( $+functions[_tale__subcmd__auth__subcmd__add_commands] )) ||
_tale__subcmd__auth__subcmd__add_commands() {
    local commands; commands=()
    _describe -t commands 'tale auth add commands' commands "$@"
}
(( $+functions[_tale__subcmd__auth__subcmd__remove_commands] )) ||
_tale__subcmd__auth__subcmd__remove_commands() {
    local commands; commands=()
    _describe -t commands 'tale auth remove commands' commands "$@"
}
(( $+functions[_tale__subcmd__auth__subcmd__status_commands] )) ||
_tale__subcmd__auth__subcmd__status_commands() {
    local commands; commands=()
    _describe -t commands 'tale auth status commands' commands "$@"
}
(( $+functions[_tale__subcmd__config_commands] )) ||
_tale__subcmd__config_commands() {
    local commands; commands=(
'path:Print configuration, credential, state, and cache locations' \
'check:Validate the configuration without opening the terminal interface' \
'show:Every resolved value and what decided it' \
    )
    _describe -t commands 'tale config commands' commands "$@"
}
(( $+functions[_tale__subcmd__config__subcmd__check_commands] )) ||
_tale__subcmd__config__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'tale config check commands' commands "$@"
}
(( $+functions[_tale__subcmd__config__subcmd__path_commands] )) ||
_tale__subcmd__config__subcmd__path_commands() {
    local commands; commands=()
    _describe -t commands 'tale config path commands' commands "$@"
}
(( $+functions[_tale__subcmd__config__subcmd__show_commands] )) ||
_tale__subcmd__config__subcmd__show_commands() {
    local commands; commands=()
    _describe -t commands 'tale config show commands' commands "$@"
}
(( $+functions[_tale__subcmd__doctor_commands] )) ||
_tale__subcmd__doctor_commands() {
    local commands; commands=()
    _describe -t commands 'tale doctor commands' commands "$@"
}
(( $+functions[_tale__subcmd__gen-completions_commands] )) ||
_tale__subcmd__gen-completions_commands() {
    local commands; commands=()
    _describe -t commands 'tale gen-completions commands' commands "$@"
}

if [ "$funcstack[1]" = "_tale" ]; then
    _tale "$@"
else
    compdef _tale tale
fi
